{
  "name": "@agentmesh/creatorcut-protocol",
  "version": "0.1.0",
  "description": "Public CreatorCut Director and local execution contracts",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./schemas/*": "./dist/schemas/*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
