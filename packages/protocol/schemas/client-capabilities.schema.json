{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.creatorcut.agentmesh360.com/v1/client-capabilities.schema.json",
  "title": "CreatorCut Public ClientCapabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "client_version",
    "host_type",
    "protocol_versions",
    "card_types",
    "operation_types",
    "supports_visual_previews",
    "supports_voice_preview",
    "max_payload_bytes"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "client_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "host_type": { "enum": ["codex", "claude_code", "openclaw", "text"] },
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "card_types": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": ["single", "multi", "text", "visual", "voice", "review"]
      }
    },
    "operation_types": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "trim",
          "split",
          "remove_range",
          "concat",
          "set_gain",
          "add_caption",
          "set_canvas",
          "apply_lut",
          "move_clip",
          "add_clip",
          "clear_track",
          "clear_captions",
          "clear_lut"
        ]
      }
    },
    "supports_visual_previews": { "type": "boolean" },
    "supports_voice_preview": { "type": "boolean" },
    "max_payload_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 4194304
    }
  }
}
