{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.creatorcut.agentmesh360.com/v1/cost-quote.schema.json",
  "title": "CreatorCut CostQuote v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "quote_id",
    "action_code",
    "cost",
    "planning_input_digest",
    "policy_version",
    "expires_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "quote_id": { "$ref": "#/$defs/id" },
    "action_code": { "const": "creatorcut.director.plan" },
    "cost": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "planning_input_digest": { "$ref": "#/$defs/digest" },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expires_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    }
  }
}
