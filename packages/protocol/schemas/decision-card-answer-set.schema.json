{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.creatorcut.agentmesh360.com/v1/decision-card-answer-set.schema.json",
  "title": "CreatorCut DecisionCardAnswerSet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "answer_set_id",
    "card_set_id",
    "card_set_digest",
    "presentation_digest",
    "capabilities_digest",
    "planning_input_digest",
    "previous_envelope_digest",
    "project_id",
    "base_revision",
    "state_revision",
    "answers"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "answer_set_id": { "$ref": "#/$defs/id" },
    "card_set_id": { "$ref": "#/$defs/id" },
    "card_set_digest": { "$ref": "#/$defs/digest" },
    "presentation_digest": { "$ref": "#/$defs/digest" },
    "capabilities_digest": { "$ref": "#/$defs/digest" },
    "planning_input_digest": { "$ref": "#/$defs/digest" },
    "previous_envelope_digest": { "$ref": "#/$defs/digest" },
    "project_id": { "$ref": "#/$defs/id" },
    "base_revision": { "type": "integer", "minimum": 0 },
    "state_revision": { "type": "integer", "minimum": 0 },
    "answers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["card_id"],
        "properties": {
          "card_id": { "$ref": "#/$defs/id" },
          "selected_option_ids": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "text_value": { "type": "string", "maxLength": 8192 },
          "approved": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
