{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.creatorcut.agentmesh360.com/v1/decision-card-set.schema.json",
  "title": "CreatorCut SemanticDecisionCardSet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "card_set_id",
    "state_revision",
    "stage",
    "cards"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "card_set_id": { "$ref": "#/$defs/id" },
    "state_revision": { "type": "integer", "minimum": 0 },
    "stage": {
      "enum": [
        "direction",
        "look_and_sound",
        "editing_review",
        "execution_confirmation"
      ]
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["card_id", "type", "title", "prompt", "required"],
        "properties": {
          "card_id": { "$ref": "#/$defs/id" },
          "type": {
            "enum": ["single", "multi", "text", "visual", "voice", "review"]
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 512 },
          "prompt": { "type": "string", "minLength": 1, "maxLength": 8192 },
          "required": { "type": "boolean" },
          "options": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["option_id", "label"],
              "properties": {
                "option_id": { "$ref": "#/$defs/id" },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "description": { "type": "string", "maxLength": 8192 },
                "preview_ref": { "$ref": "#/$defs/id" }
              }
            }
          },
          "min_selections": { "type": "integer", "minimum": 0, "maximum": 16 },
          "max_selections": { "type": "integer", "minimum": 1, "maximum": 16 }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
