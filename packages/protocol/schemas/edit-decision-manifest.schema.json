{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.creatorcut.agentmesh360.com/v1/edit-decision-manifest.schema.json",
  "title": "CreatorCut EditDecisionManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "review_plan_digest",
    "final_decisions_digest",
    "billing_receipt_ref",
    "required_operation_types",
    "operations",
    "finishing",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "manifest_id": { "$ref": "#/$defs/id" },
    "review_plan_digest": { "$ref": "#/$defs/digest" },
    "final_decisions_digest": { "$ref": "#/$defs/digest" },
    "billing_receipt_ref": { "$ref": "#/$defs/id" },
    "required_operation_types": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "trim",
          "split",
          "remove_range",
          "concat",
          "set_gain",
          "add_caption",
          "set_canvas",
          "apply_lut",
          "move_clip",
          "add_clip",
          "clear_track",
          "clear_captions",
          "clear_lut"
        ]
      }
    },
    "operations": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "https://schemas.creatorcut.agentmesh360.com/v1/edit-operation.schema.json"
      }
    },
    "finishing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caption_style_id",
        "lut_id",
        "voice_mode",
        "background_music"
      ],
      "properties": {
        "caption_style_id": {
          "enum": ["caption_none", "caption_clean", "caption_bold"]
        },
        "lut_id": {
          "enum": ["lut_none", "lut_warm", "lut_cool"]
        },
        "voice_mode": {
          "enum": ["original", "partial_voiceover", "full_voiceover"]
        },
        "background_music": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": { "mode": { "const": "none" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "category_id", "template_id"],
              "properties": {
                "mode": { "const": "local_template" },
                "category_id": { "const": "upbeat" },
                "template_id": {
                  "enum": ["light_tech", "bright_launch"]
                }
              }
            }
          ]
        }
      }
    },
    "summary": { "type": "string", "maxLength": 8192 }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
