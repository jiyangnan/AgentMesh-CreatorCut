{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.creatorcut.agentmesh360.com/v1/keyset.schema.json",
  "title": "CreatorCut Signed Artifact Keyset v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "keyset_version",
    "purpose",
    "issued_at",
    "expires_at",
    "keys",
    "signature"
  ],
  "properties": {
    "keyset_version": { "type": "integer", "minimum": 1 },
    "purpose": { "enum": ["director", "release"] },
    "issued_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "status",
          "public_key_pem",
          "not_before",
          "not_after"
        ],
        "properties": {
          "key_id": { "$ref": "#/$defs/id" },
          "status": { "enum": ["current", "previous", "revoked"] },
          "public_key_pem": {
            "type": "string",
            "minLength": 80,
            "maxLength": 1024,
            "pattern": "^-----BEGIN PUBLIC KEY-----"
          },
          "not_before": { "$ref": "#/$defs/timestamp" },
          "not_after": { "$ref": "#/$defs/timestamp" }
        }
      }
    },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    }
  }
}
